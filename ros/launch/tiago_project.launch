<?xml version="1.0"?>
<launch>
  <!-- Controller node -->
  <node pkg="tiago_project" type="controller.py" name="controller" output="screen">
    <param name="head_tilt" value="-0.2" />
    <param name="head_pan_limit_deg" value="70.0" />
    <param name="head_tilt_min_deg" value="-56.0" />
    <param name="head_tilt_max_deg" value="41.0" />
    <param name="head_aim_step_deg" value="2.0" />
    <param name="standoff_dist" value="0.5" />
    <param name="regoal_threshold" value="0.3" />
    <param name="update_wait_timeout" value="15.0" />
    <param name="capture_period" value="2.0" />
    <param name="initial_capture_delay" value="3.0" />
  </node>

  <!-- Pilot node -->
  <node pkg="tiago_project" type="pilot.py" name="pilot_interface" output="screen">
    <param name="server_ip" value="10.41.59.6" />
    <param name="spin_step_angle_deg" value="45.0" />
    <param name="vlm_image_width" value="640.0" />
    <param name="vlm_image_height" value="480.0" />
  </node>
</launch>
